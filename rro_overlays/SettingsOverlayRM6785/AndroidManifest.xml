<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.settings.overlay"
    android:versionCode="1"
    android:versionName="1.0">

    <application>
        
        <!-- Quick Settings Icon Management Activity -->
        <activity
            android:name=".QuickSettingsIconManagerActivity"
            android:label="@string/quick_settings_icon_management"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
            android:exported="false">
            
            <!-- Intent filter for accessing icon management -->
            <intent-filter>
                <action android:name="com.android.settings.action.QUICK_SETTINGS_ICON_MANAGEMENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            
        </activity>
        
        <!-- Service for managing quick settings configuration -->
        <service
            android:name=".QuickSettingsConfigService"
            android:exported="false" />
            
    </application>
    
</manifest>