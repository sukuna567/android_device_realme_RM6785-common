<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:layout_margin="4dp"
    android:elevation="2dp"
    android:translationZ="0dp">

    <!-- Drag Handle -->
    <ImageView
        android:id="@+id/icon_drag_handle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_drag_handle"
        android:contentDescription="Drag to reorder"
        android:tint="?android:attr/textColorSecondary"
        android:alpha="0.6"
        android:padding="4dp" />

    <!-- Icon Image -->
    <ImageView
        android:id="@+id/icon_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_wifi"
        android:contentDescription="Quick setting icon"
        android:tint="?android:attr/textColorPrimary" />

    <!-- Icon Name -->
    <TextView
        android:id="@+id/icon_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_gravity="center_vertical"
        android:text="Wi-Fi"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:fontFamily="sans-serif-medium" />

    <!-- Icon Status Indicator -->
    <ImageView
        android:id="@+id/icon_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_status_enabled"
        android:contentDescription="Status indicator"
        android:visibility="gone" />

    <!-- Remove Icon -->
    <ImageView
        android:id="@+id/icon_remove"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_remove"
        android:contentDescription="Remove icon"
        android:tint="?android:attr/textColorSecondary"
        android:visibility="gone"
        android:padding="4dp" />

</LinearLayout>