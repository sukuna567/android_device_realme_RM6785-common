<resources>
    
    <!-- Quick Settings Icon Management Theme -->
    <style name="Theme.QuickSettingsIconManager" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/quick_settings_primary</item>
        <item name="colorPrimaryDark">@color/quick_settings_primary_dark</item>
        <item name="colorAccent">@color/quick_settings_accent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    
    <!-- Icon Item Styles -->
    <style name="QuickSettingsIconItem" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    
    <!-- Button Styles -->
    <style name="QuickSettingsButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="QuickSettingsButton.Primary" parent="QuickSettingsButton">
        <item name="colorButtonNormal">@color/quick_settings_accent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    
    <style name="QuickSettingsButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <!-- RecyclerView Styles -->
    <style name="QuickSettingsRecyclerView" parent="Widget.AppCompat.RecyclerView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">8dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">vertical</item>
    </style>
    
    <!-- Grid Layout Styles -->
    <style name="QuickSettingsGrid" parent="Widget.AppCompat.GridLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:columnCount">3</item>
        <item name="android:rowCount">3</item>
        <item name="android:padding">8dp</item>
        <item name="android:alignmentMode">alignMargins</item>
    </style>
    
    <!-- Drag and Drop Visual Feedback -->
    <style name="QuickSettingsDragShadow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:elevation">8dp</item>
        <item name="android:translationZ">4dp</item>
    </style>
    
    <!-- Toast Styles -->
    <style name="QuickSettingsToast" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/quick_settings_toast_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
    </style>
    
</resources>